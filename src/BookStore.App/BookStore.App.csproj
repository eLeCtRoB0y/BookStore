<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BookStore.App</RootNamespace>
    <AssemblyName>BookStore</AssemblyName>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Product>ЧитайГород: учёт товаров</Product>
    <!-- Позволяет собирать проект и на не-Windows машинах (CI). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookStore.Data\BookStore.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\logo.png" />
    <Resource Include="Resources\picture.png" />
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Фото товаров лежат в папке приложения: туда же сохраняются новые изображения. -->
    <None Include="Images\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Database\BookStore.db" Link="BookStore.db" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Database\BookStore.sql" Link="BookStore.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
