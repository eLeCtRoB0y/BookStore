<Window x:Class="BookStore.App.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование товара"
        Style="{StaticResource WindowStyle}"
        Width="820" Height="720" MinWidth="700" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SecondaryBackgroundBrush}" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Border Background="{StaticResource LogoBrush}" Width="124" Height="40" Margin="0,0,16,0" />
                <TextBlock x:Name="HeaderText" Text="Редактирование товара" Style="{StaticResource HeaderTitle}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Фото товара -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <Border BorderBrush="{StaticResource BorderBrushMain}" BorderThickness="1" Width="302" Height="202">
                        <Image x:Name="PhotoImage" Stretch="Uniform" />
                    </Border>
                    <Button x:Name="ChoosePhotoButton" Content="Выбрать изображение" Margin="0,8,0,0"
                            Click="ChoosePhotoButton_Click"
                            ToolTip="Изображение будет уменьшено до 300×200 пикселей и сохранено в папку программы" />
                    <TextBlock Text="Размер фото ограничен 300×200 пикселей." Foreground="Gray"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Поля товара -->
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="IdLabel" Grid.Row="0" Text="ID товара" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="IdBox" Grid.Row="0" Grid.Column="1" Margin="0,4" IsReadOnly="True"
                             Background="#EEEEEE" ToolTip="ID назначается автоматически и не редактируется" />

                    <TextBlock Grid.Row="1" Text="Артикул *" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ArticleBox" Grid.Row="1" Grid.Column="1" Margin="0,4" MaxLength="20"
                             ToolTip="Уникальный артикул, например A112T4" />

                    <TextBlock Grid.Row="2" Text="Наименование *" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NameBox" Grid.Row="2" Grid.Column="1" Margin="0,4" />

                    <TextBlock Grid.Row="3" Text="Категория *" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="CategoryBox" Grid.Row="3" Grid.Column="1" Margin="0,4"
                              DisplayMemberPath="Name" SelectedValuePath="Id" />

                    <TextBlock Grid.Row="4" Text="Описание" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Top" Margin="0,8,10,0" />
                    <TextBox x:Name="DescriptionBox" Grid.Row="4" Grid.Column="1" Margin="0,4" Height="110"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" />

                    <TextBlock Grid.Row="5" Text="Производитель *" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="ManufacturerBox" Grid.Row="5" Grid.Column="1" Margin="0,4" IsEditable="True"
                              ToolTip="Выберите из списка или введите нового производителя" />

                    <TextBlock Grid.Row="6" Text="Поставщик *" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="SupplierBox" Grid.Row="6" Grid.Column="1" Margin="0,4"
                              DisplayMemberPath="Name" SelectedValuePath="Id" />

                    <TextBlock Grid.Row="7" Text="Цена, ₽ *" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="PriceBox" Grid.Row="7" Grid.Column="1" Margin="0,4"
                             ToolTip="Неотрицательное число, не более двух знаков после запятой, например 585,50" />

                    <TextBlock Grid.Row="8" Text="Единица измерения *" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="UnitBox" Grid.Row="8" Grid.Column="1" Margin="0,4" IsEditable="True" />

                    <TextBlock Grid.Row="9" Text="Количество на складе *" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="QuantityBox" Grid.Row="9" Grid.Column="1" Margin="0,4"
                             ToolTip="Целое неотрицательное число" />

                    <TextBlock Grid.Row="10" Text="Действующая скидка, % *" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="DiscountBox" Grid.Row="10" Grid.Column="1" Margin="0,4"
                             ToolTip="Целое число от 0 до 100" />

                    <TextBlock Grid.Row="11" Grid.ColumnSpan="2" Text="* — поля, обязательные для заполнения"
                               Foreground="Gray" Margin="0,8,0,0" />
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SecondaryBackgroundBrush}" Padding="12,6">
            <DockPanel LastChildFill="False">
                <Button x:Name="BackButton" DockPanel.Dock="Left" Content="Назад"
                        Style="{StaticResource SecondaryButton}" IsCancel="True" Click="BackButton_Click" />
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Сохранить" Click="SaveButton_Click" />
                <Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="Удалить товар"
                        Style="{StaticResource DangerButton}" Click="DeleteButton_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
