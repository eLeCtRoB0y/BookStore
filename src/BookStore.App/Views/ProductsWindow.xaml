<Window x:Class="BookStore.App.Views.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список товаров — ЧитайГород"
        Style="{StaticResource WindowStyle}"
        Width="1150" Height="760" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ProductItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ProductItem_Click" />
        </Style>

        <DataTemplate x:Key="ProductTemplate">
            <Border x:Name="RowBorder" BorderBrush="{StaticResource BorderBrushMain}" BorderThickness="1"
                    Background="{StaticResource MainBackgroundBrush}" Padding="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrushMain}" BorderThickness="1"
                            Background="White" Padding="4">
                        <Image Source="{Binding PhotoPath, Converter={StaticResource PhotoConverter}}"
                               Height="130" Stretch="Uniform" />
                    </Border>

                    <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrushMain}" BorderThickness="1"
                            Margin="6,0" Padding="8,4">
                        <StackPanel>
                            <TextBlock Text="{Binding Header}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="Описание товара: " /><Run Text="{Binding Description, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="Производитель: " /><Run Text="{Binding ManufacturerName, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="Поставщик: " /><Run Text="{Binding SupplierName, Mode=OneWay}" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Цена: " />
                                <TextBlock x:Name="PriceText" Text="{Binding PriceText}" Foreground="Black" />
                                <TextBlock x:Name="FinalPriceText" Text="{Binding FinalPriceText}" Foreground="Black"
                                           Margin="8,0,0,0" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock>
                                <Run Text="Единица измерения: " /><Run Text="{Binding UnitName, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="Количество на складе: " /><Run Text="{Binding StockQuantity, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrushMain}" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Действующая скидка" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DiscountText}" FontSize="26" FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- Цена со скидкой: основная зачёркнута красным, рядом итоговая чёрным. -->
                <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                    <Setter TargetName="PriceText" Property="Foreground" Value="Red" />
                    <Setter TargetName="PriceText" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="FinalPriceText" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBigDiscount}" Value="True">
                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource BigDiscountBrush}" />
                </DataTrigger>
                <!-- Стоит последним: отсутствие на складе важнее подсветки скидки. -->
                <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource OutOfStockBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка: логотип, заголовок, ФИО пользователя и выход -->
        <Border Grid.Row="0" Background="{StaticResource SecondaryBackgroundBrush}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource LogoBrush}" Width="160" Height="52" Margin="0,0,16,0" />
                <TextBlock Grid.Column="1" Text="Список товаров" Style="{StaticResource HeaderTitle}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="UserNameText" FontWeight="Bold" HorizontalAlignment="Right" />
                        <TextBlock x:Name="UserRoleText" HorizontalAlignment="Right" Foreground="#555555" />
                    </StackPanel>
                    <Button x:Name="LogoutButton" Content="Выйти" Style="{StaticResource SecondaryButton}"
                            Click="LogoutButton_Click" ToolTip="Выйти из учётной записи и вернуться к окну входа" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Поиск, сортировка, фильтр — только для менеджера и администратора -->
        <WrapPanel Grid.Row="1" x:Name="ToolsPanel" Margin="12,8,12,0">
            <Grid Width="300" Margin="0,4,12,4" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
                         ToolTip="Поиск по артикулу, наименованию, описанию, категории, производителю, поставщику. Можно ввести несколько слов." />
                <TextBlock x:Name="SearchHint" Text="Поиск..." Foreground="Gray" Margin="8,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="SortBox" Width="220" Margin="0,4,12,4" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="Без сортировки" />
                <ComboBoxItem Content="Цена по возрастанию" />
                <ComboBoxItem Content="Цена по убыванию" />
                <ComboBoxItem Content="Количество по возрастанию" />
                <ComboBoxItem Content="Количество по убыванию" />
            </ComboBox>
            <TextBlock Text="Скидка:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="DiscountBox" Width="160" Margin="0,4,12,4" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="Все диапазоны" />
                <ComboBoxItem Content="0-12,99%" />
                <ComboBoxItem Content="13-16,99%" />
                <ComboBoxItem Content="17% и более" />
            </ComboBox>
            <Button x:Name="OrdersButton" Content="Заказы" Click="OrdersButton_Click" />
            <Button x:Name="AddProductButton" Content="Добавить товар" Click="AddProductButton_Click" />
        </WrapPanel>

        <ListBox Grid.Row="2" x:Name="ProductsList" Margin="12,8"
                 ItemTemplate="{StaticResource ProductTemplate}"
                 ItemContainerStyle="{StaticResource ProductItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="0" />

        <TextBlock Grid.Row="3" x:Name="CountText" Margin="12,0,12,8" Foreground="#555555" />
    </Grid>
</Window>
